---
import { getEntry } from 'astro:content';
import Icon from '../components/Icon.astro';

export interface Props {
  title: string;
  description?: string;
  bodyId?: string;
  /** Load KaTeX CSS/JS (project detail pages with math). */
  katex?: boolean;
  /** Load the creative-page interaction script. */
  creativeJs?: boolean;
  /** Emit Person JSON-LD (homepage and /about — the pages that describe him). */
  personSchema?: boolean;
  /** Override the social share image (absolute path under /public). */
  ogImage?: string;
  /** og:type — "article" on project detail pages. */
  ogType?: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  bodyId = 'homepage',
  katex = false,
  creativeJs = false,
  personSchema = false,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const site = await getEntry('settings', 'site');
const metaDescription = description ?? site.data.metaDescription;

// Absolute URLs — Open Graph and JSON-LD both reject relative ones.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const s = site.data.socials;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.data.name,
  url: Astro.site?.href,
  image: ogImageUrl.href,
  jobTitle: site.data.tagline,
  description: site.data.metaDescription,
  email: s.email ? `mailto:${s.email}` : undefined,
  sameAs: [s.github, s.linkedin, s.twitter, s.youtube, s.instagram, s.orcid].filter(Boolean),
  alumniOf: site.data.footer.timeline
    .filter((t) => /university|college|school/i.test(t.org))
    .map((t) => ({ '@type': 'EducationalOrganization', name: t.org })),
  worksFor: site.data.footer.timeline
    .filter((t) => /present/i.test(t.time) && !/university|college|school/i.test(t.org))
    .map((t) => ({ '@type': 'Organization', name: t.org })),
};
---

<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

  <title>{title}</title>

  <!-- Must stay inline and render-blocking: it sets data-theme before first
       paint, so dark-mode visitors don't get a flash of the light palette.
       script.js only handles the toggle from here on. -->
  <script is:inline>
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  </script>

  <link rel="stylesheet" href="/assets/css/resets.css" />
  <link rel="stylesheet" href="/assets/css/styles.css" />
  <!-- Paths must match the @font-face src in styles.css, or the browser
       downloads these twice and warns that the preload went unused. -->
  <link rel="preload" href="/assets/fonts/Reforma1918/Reforma1918-GrisItalica.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/assets/fonts/Reforma1969/Reforma1969-Gris.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="stylesheet" href="/assets/css/print.css" media="print" />

  {katex && (
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  )}

  <meta name="description" content={metaDescription} />
  <meta name="author" content={site.data.name} />
  <link rel="canonical" href={canonical.href} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:site_name" content={site.data.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImageUrl.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.data.name} — ${site.data.tagline}`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageUrl.href} />

  <link rel="icon" href="/favicon.ico" />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#003153" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#FFEFD5" media="(prefers-color-scheme: light)" />

  {personSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
  )}

  <!-- Scroll-reveal: initial hidden state (only when JS is on and motion is allowed).
       Keep this selector list in sync with SEL in /assets/js/reveal.js. -->
  <style is:global>
    @media (prefers-reduced-motion: no-preference) {
      html.js :is(
        .hero__content, .section__header, .now__main, .research__item,
        .research__publications, .project-card, .moto-intro, .moto-card,
        .moto-links, .cv-timeline__item, .about__content > p,
        .project-content > *, .project-hero__header
      ) {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      html.js :is(
        .hero__content, .section__header, .now__main, .research__item,
        .research__publications, .project-card, .moto-intro, .moto-card,
        .moto-links, .cv-timeline__item, .about__content > p,
        .project-content > *, .project-hero__header
      ).is-visible {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

<body id={bodyId}>
  <!-- Skip link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Theme Toggle -->
  <div class="checkbox">
    <input type="checkbox" id="checkbox_t" aria-label="Toggle dark mode" />
    <label for="checkbox_t" class="label">
      <Icon name="sun" id="sun" class="toggle-icon" size={14} />
      <Icon name="moon" id="moon" class="toggle-icon" size={14} />
      <div class="ball"></div>
    </label>
  </div>

  <slot />

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1/dist/lenis.min.js"></script>
  <script is:inline src="/assets/js/smooth-scroll.js"></script>
  {creativeJs && <script is:inline src="/assets/js/creative.js"></script>}
  <script is:inline src="/assets/js/script.js" type="module"></script>
  <script is:inline src="/assets/js/reveal.js"></script>
  <script is:inline defer src="/assets/js/visitors.js"></script>
  {katex && (
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  )}
</body>
</html>
